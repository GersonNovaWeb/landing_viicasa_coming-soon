# Safe default: visual preview only, no connection to real data.
FIREBASE_MODE=disabled
FIREBASE_PROJECT_ID=viicasa
GOOGLE_APPLICATION_CREDENTIALS=
# Hosting alternative: complete service-account JSON, PRIVATE server variable.
# Never prefix with NEXT_PUBLIC_. Takes precedence over the local file above.
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=viicasa.database@gmail.com
SITE_URL=http://127.0.0.1:3010
REGISTRATION_ENABLED=false
PRIVACY_APPROVED=false
PRIVACY_CONTACT_EMAIL=
# For local integration tests only: mode=emulator, project=demo-viicasa-comingsoon
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9096
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9096
NEXT_PUBLIC_FIREBASE_MODE=disabled
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDBDhdmpSlfUAeGYZ8UPKkE2A3S70dvEY8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=viicasa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=viicasa
NEXT_PUBLIC_FIREBASE_APP_ID=1:159084480889:web:f193adc5bcde06897fc7a8
# Registration works without SMTP. Welcome emails require SMTP and activation
# per service in Admin > Automatic emails. Never put these in NEXT_PUBLIC_ vars.
MAIL_MODE=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Shared budget for welcome emails and admin tests in a rolling 24-hour window.
# Leave margin for manual emails from the same mailbox. Adjust to provider limits.
MAIL_DAILY_LIMIT=90
